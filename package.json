{
  "name": "refract",
  "version": "0.34.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "description": "Desktop workspace that drives omp --mode rpc-ui, one process per session worktree.",
  "type": "commonjs",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build --no-bundle",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "check:indent": "node scripts/check-indent.mjs",
    "test": "vitest run",
    "check:ui-text": "node scripts/check-ui-text.mjs",
    "check:drag-regions": "node scripts/check-drag-regions.mjs",
    "check:theme-contrast": "node scripts/check-theme-contrast.mjs",
    "check:display-profiles": "node scripts/check-display-profiles.mjs",
    "check:mermaid-contrast": "node scripts/check-mermaid-contrast.mjs",
    "verify:tauri": "node scripts/verify-tauri.mjs",
    "verify:tauri-008": "node scripts/verify-tauri-008.mjs",
    "verify:tauri-1856": "node scripts/verify-tauri-1856.mjs",
    "probe:token-guard": "node scripts/token-guard-probe/run.mjs",
    "verify:tauri-081": "node scripts/verify-tauri-081.mjs",
    "verify:tauri-084": "node scripts/verify-tauri-084.mjs",
    "verify:tauri-086": "node scripts/verify-tauri-086.mjs",
    "verify:1238": "node scripts/verify-1238-ai-credits.mjs",
    "check:parity": "node scripts/check-parity.mjs",
    "check:file-size": "node scripts/check-file-size.mjs",
    "check:comment-density": "node scripts/check-comment-density.mjs",
    "check:spacing": "node scripts/check-spacing.mjs",
    "check:alpha-modifiers": "node scripts/check-alpha-modifiers.mjs",
    "check:icon-only-controls": "node scripts/check-icon-only-controls.mjs",
    "check:literal-colours": "node scripts/check-literal-colours.mjs",
    "check:hit-targets": "node scripts/check-hit-targets.mjs",
    "check:advisor-roster": "node scripts/check-advisor-roster.mjs",
    "worktrees:reap": "node scripts/worktrees-reap.mjs",
    "check:omp-schema": "node scripts/check-omp-schema-drift.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "ci:local": "node scripts/ci-local.mjs",
    "cache:sweep": "node scripts/cache-sweep.mjs",
    "release": "node scripts/release.mjs",
    "release:local": "node scripts/release-local.mjs"
