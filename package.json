    "cn": "0.4.0",
    "diff": "9.0.0",
    "lucide-react": "1.49.0",
    "mermaid": "11.17.2",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-diff-view": "3.3.3",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.14.1",
    "react-virtuoso": "4.18.16",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.4.3",
    "sonner": "2.0.8",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/api": "2.12.3",
    "@tauri-apps/cli": "2.12.2",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/typescript6": "6.0.2",
    "@vitejs/plugin-react": "5.2.0",
    "js-yaml": "4.3.2",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@modelcontextprotocol/sdk": "1.32.0",
      "dompurify": "3.4.17",
      "fast-uri": "3.1.9",
      "katex": "0.18.2",
      "minimatch": "11.0.1",
      "qs": "6.16.1",
      "systeminformation": "5.33.16",
      "undici": "7.30.1"
