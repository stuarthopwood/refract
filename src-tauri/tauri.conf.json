{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Refract",
  "version": "0.34.0",
  "identifier": "com.stuarthopwood.refract.rust-preview",
  "build": {
    "beforeDevCommand": "pnpm exec vite --config tauri.vite.config.ts",
    "beforeBuildCommand": "pnpm exec vite build --config tauri.vite.config.ts",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../out/tauri-web"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "installer/uninstaller.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerHooks": "installerHooks.nsh"
      }
    }
  }
}
