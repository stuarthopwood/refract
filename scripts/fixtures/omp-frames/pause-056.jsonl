// Fixture for issue #477 (Pause mode, spec 056). Hand-written; the start-up preamble reuses
// session.jsonl's own genuinely-recorded shapes. The one turn holds open for 12 seconds
// (`__delay__`) after the assistant starts streaming, so scripts/verify-056-pause-mode.mjs can
// press Pause mid-turn and see "Pausing...", then lets the turn end so the Session becomes
// Paused. `$conversationFile` is a real file the script pre-creates, so the reopen tape
// (pause-056-reopen.jsonl) can reattach to it after an app restart.
{"type":"ready","protocolVersion":1,"supportedProtocolVersions":[1,2],"maxFrameBytes":1048576,"maxReassembledFrameBytes":67108864}
{"__wait__":["negotiate_protocol"]}
{"id":"$lastId","type":"response","command":"negotiate_protocol","success":true,"data":{"protocolVersion":2}}
{"__wait__":["get_state"]}
{"id":"$lastId","type":"response","command":"get_state","success":true,"data":{"sessionFile":"$conversationFile","sessionId":"sess-056","messageCount":0,"isSettled":true,"model":{"provider":"example-provider","id":"example-model-1","name":"Example Model One"},"thinkingLevel":"medium"}}
{"__wait__":["set_ask_dialog"]}
{"id":"$lastId","type":"response","command":"set_ask_dialog","success":true,"data":{"enabled":true}}
{"type":"available_commands_update","commands":[{"name":"new","description":"Start a new Conversation in this Session"}]}
{"__wait__":["get_messages_page","get_messages"]}
{"id":"$lastId","type":"response","command":"get_messages_page","success":true,"data":{"messages":[],"totalMessages":0}}
{"__wait__":["prompt"]}
{"id":"$turnId","type":"response","command":"prompt","success":true}
{"type":"agent_start"}
{"type":"message_start","messageId":"msg-u1","message":{"role":"user","content":[{"type":"text","text":"$lastMessage"}],"timestamp":0}}
{"type":"message_end","messageId":"msg-u1","message":{"role":"user","content":[{"type":"text","text":"$lastMessage"}],"timestamp":0}}
{"type":"message_start","messageId":"msg-a1","message":{"role":"assistant","content":[{"type":"text","text":""}],"timestamp":0}}
{"type":"message_update","messageId":"msg-a1","assistantMessageEvent":{"type":"text_delta","contentIndex":0,"partial":{"role":"assistant","content":[{"type":"text","text":"Working on it"}],"timestamp":0}}}
{"__delay__":12000}
{"type":"message_update","messageId":"msg-a1","assistantMessageEvent":{"type":"text_delta","contentIndex":0,"partial":{"role":"assistant","content":[{"type":"text","text":"Working on it. Done: PAUSE-056."}],"timestamp":0}}}
{"type":"message_end","messageId":"msg-a1","message":{"role":"assistant","content":[{"type":"text","text":"Working on it. Done: PAUSE-056."}],"timestamp":0}}
{"type":"queue_update","steering":[],"followUp":[],"liveSteered":0}
{"type":"agent_end","messages":[],"isTerminal":true,"yielded":false}
{"id":"$turnId","type":"prompt_result","agentInvoked":true,"status":"completed","sessionSettled":true}
{"type":"session_settled"}
{"__wait__":["get_state"]}
{"id":"$lastId","type":"response","command":"get_state","success":true,"data":{"sessionFile":"$conversationFile","sessionId":"sess-056","messageCount":2,"isSettled":true,"model":{"provider":"example-provider","id":"example-model-1","name":"Example Model One"},"thinkingLevel":"medium"}}
{"__wait__":["never_sent"]}
