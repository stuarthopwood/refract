dist/
*.tsbuildinfo
out/
out/tauri-web/
src-tauri/target/
# `tauri-build`'s own generated JSON schemas (IDE autocompletion for capabilities' `$schema`
# field) -- regenerated by every `cargo build`, never hand-authored (tauri-apps/tauri's own
# example `.gitignore` ignores this the same way).
src-tauri/gen/
release/
coverage/
.env
.env.*
*.log
.DS_Store
Thumbs.db

# Agent config folder: keep shared slash commands, ignore everything else
# (sessions, local settings, or credentials the agent may store here).
.omp/*
!.omp/commands/
!.omp/skills/
!.omp/config.yml

.impeccable/
